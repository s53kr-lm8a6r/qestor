{
  "name": "qestor",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "dotenv -e .env -- concurrently \"pnpm run dev:api\" \"pnpm run dev:web\"",
    "dev:web": "dotenv -e .env -- pnpm --filter @qestor/web dev",
    "dev:api": "dotenv -e .env -- pnpm --filter @qestor/api start:debug",
    "build": "pnpm run build:packages && pnpm run build:api && pnpm run build:web",
    "build:packages": "pnpm --filter \"./packages/*\" build",
    "build:web": "dotenv -e .env -- pnpm --filter @qestor/web build",
    "build:api": "dotenv -e .env -- pnpm --filter @qestor/api build",
    "start": "dotenv -e .env -- concurrently \"pnpm run start:api\" \"pnpm run start:web\"",
    "start:web": "dotenv -e .env -- pnpm --filter @qestor/web start",
    "start:api": "dotenv -e .env -- pnpm --filter @qestor/api start:prod",
    "lint": "pnpm --filter @qestor/web lint && pnpm --filter @qestor/api lint",
    "test": "dotenv -e .env -- pnpm --filter @qestor/api test",
    "type-check": "pnpm --filter \"./packages/*\" type-check",
    "install:all": "pnpm install",
    "env:setup": "cp env.example .env"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "dotenv-cli": "^7.4.2"
  },
  "packageManager": "pnpm@10.9.0+sha512.0486e394640d3c1fb3c9d43d49cf92879ff74f8516959c235308f5a8f62e2e19528a65cdc2a3058f587cde71eba3d5b56327c8c33a97e4c4051ca48a10ca2d5f",
  "dependencies": {
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2"
  }
}
